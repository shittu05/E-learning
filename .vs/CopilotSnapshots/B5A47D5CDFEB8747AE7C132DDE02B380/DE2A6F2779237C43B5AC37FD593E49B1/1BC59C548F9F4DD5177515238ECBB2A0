@login_required
def video_analytics(request):
    """Admin dashboard showing video analytics"""
    if not (request.user.is_staff or request.user.is_superuser):
        messages.error(request, 'Access denied. Admin only.')
        return redirect('learning')

    # Get all video events
    from django.db.models import Count, Avg, Max, F
    from django.db.models.functions import Cast
    from django.db import models as db_models

    # Aggregate by video
    video_stats = VideoEvent.objects.filter(
        event_type__in=['pause', 'ended']
    ).values('video_id', 'course_title').annotate(
        total_users=Count('user', distinct=True),
        avg_watch_time=Avg('watch_duration'),
        max_watch_time=Max('watch_duration'),
        total_events=Count('id')
    ).order_by('-total_users')

    # Convert to list for template
    analytics_data = []
    for stat in video_stats:
        analytics_data.append({
            'video_id': stat['video_id'],
            'course_title': stat['course_title'],
            'total_users': stat['total_users'],
            'avg_watch_time': round(stat['avg_watch_time'] or 0, 2),
            'max_watch_time': round(stat['max_watch_time'] or 0, 2),
            'total_events': stat['total_events'],
            'avg_watch_minutes': round((stat['avg_watch_time'] or 0) / 60, 2),
        })

    context = {
        'analytics_data': analytics_data,
        'total_videos': len(analytics_data),
        'total_unique_users': VideoEvent.objects.filter(
            event_type__in=['pause', 'ended']
        ).values('user').distinct().count()
    }

    return render(request, 'analytics.html', context)


@login_required
def student_progress(request):
    """Show student's video progress"""
    from Myapp.models import VideoProgress

    # Get or create progress records for current user
    user_progress = VideoProgress.objects.filter(user=request.user).order_by('-last_accessed')

    # Calculate stats
    total_videos = user_progress.count()
    completed_videos = user_progress.filter(is_completed=True).count()
    total_watched = sum([p.watched_duration for p in user_progress])
    avg_completion = (sum([p.completion_percentage for p in user_progress]) / total_videos) if total_videos > 0 else 0

    # Update progress for each video based on latest VideoEvent
    for progress in user_progress:
        progress.update_progress()

    context = {
        'user_progress': user_progress,
        'total_videos': total_videos,
        'completed_videos': completed_videos,
        'total_watched_seconds': int(total_watched),
        'total_watched_minutes': round(total_watched / 60, 2),
        'avg_completion_percentage': round(avg_completion, 1),
    }

    return render(request, 'student_progress.html', context)


@login_required
def admin_student_analytics(request):
    """Admin view of all students' progress"""
    if not (request.user.is_staff or request.user.is_superuser):
        messages.error(request, 'Access denied. Admin only.')
        return redirect('learning')

    from Myapp.models import VideoProgress
    from django.contrib.auth import get_user_model

    UserModel = get_user_model()

    # Get all users with video progress
    all_users = VideoProgress.objects.values_list('user', flat=True).distinct()

    student_stats = []
    for user_id in all_users:
        user = UserModel.objects.get(id=user_id)
        progress_records = VideoProgress.objects.filter(user=user)

        total_watched = sum([p.watched_duration for p in progress_records])
        total_videos = progress_records.count()
        completed = progress_records.filter(is_completed=True).count()
        avg_completion = (sum([p.completion_percentage for p in progress_records]) / total_videos) if total_videos > 0 else 0

        student_stats.append({
            'user': user,
            'total_videos_enrolled': total_videos,
            'completed_videos': completed,
            'completion_rate': round(avg_completion, 1),
            'total_watched_minutes': round(total_watched / 60, 2),
            'last_activity': progress_records.aggregate(Max('last_accessed'))['last_accessed__max']
        })

    # Sort by completion rate
    student_stats.sort(key=lambda x: x['completion_rate'], reverse=True)

    context = {
        'student_stats': student_stats,
        'total_students': len(student_stats),
    }

    return render(request, 'admin_student_analytics.html', context)




